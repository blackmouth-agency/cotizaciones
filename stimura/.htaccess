# Stimura · cabeceras de seguridad y caché (Hostinger / LiteSpeed)
Options -Indexes
ServerSignature Off
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteRule (^|/)\. - [F]
  RewriteRule ^carrito/?$ /pagar/ [L,R=301]
  RewriteRule ^finalizar-compra/?$ /pagar/ [L,R=301]
  RewriteRule ^mi-cuenta/?$ / [L,R=301]
  RewriteRule ^hacer-un-pedido/?$ /tienda/ [L,R=301]
  RewriteRule ^sample-page/?$ / [L,R=301]
  RewriteRule ^hello-world/?$ / [L,R=301]
  RewriteRule ^producto/?$ /tienda/ [L,R=301]
  RewriteRule ^blog/?$ / [L,R=301]
  RewriteRule ^visitanos/?$ /contacto/ [L,R=301]
  RewriteRule ^producto/coleccion-olfative-mind/?$ /tienda/kit-olfactive-mind/ [L,R=301]
  RewriteRule ^producto/olfative-mind-mango-season/?$ /tienda/mango-season/ [L,R=301]
  RewriteRule ^producto/olfative-mind-milk-para-dormir/?$ /tienda/milk-para-dormir/ [L,R=301]
  RewriteRule ^producto/olfative-mind-baby-sandia/?$ /tienda/baby-sandia/ [L,R=301]
  RewriteRule ^producto/black-and-white/?$ /tienda/patitos-in-the-bath/ [L,R=301]
  RewriteRule ^producto/tintico/?$ /tienda/tintico/ [L,R=301]
  RewriteRule ^producto/nubes-de-vainilla/?$ /tienda/nubes-de-vainilla/ [L,R=301]
  RewriteRule ^producto/waxmelt-brisa-marina/?$ /tienda/brisa-marina/ [L,R=301]
  RewriteRule ^producto/pebetero-de-gota/?$ /tienda/pebetero-de-gota/ [L,R=301]
  RewriteRule ^producto/vela-de-te-paqx10-und/?$ /tienda/velas-de-te/ [L,R=301]
  RewriteRule ^producto/bano-de-afrodita/?$ /tienda/bano-de-afrodita/ [L,R=301]
  RewriteRule ^producto/petalo/?$ /tienda/petalo/ [L,R=301]
  RewriteRule ^producto/candy-pop/?$ /tienda/candy-pop/ [L,R=301]
  RewriteRule ^producto/vela-para-masaje/?$ /tienda/vela-para-masaje/ [L,R=301]
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' blob: http://localhost:8850; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; frame-src https://www.google.com; object-src 'none'; worker-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
  <FilesMatch "\.(webp|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
ErrorDocument 404 /404.html
